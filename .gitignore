# ============================================================
# .gitignore —— 告诉 Git 哪些文件/目录不纳入版本控制
# 核心思路：只提交源码和配置模板，忽略一切可再生的、
# 临时的、敏感的和机器特定的内容
# ============================================================

# ------------------------------------------------------------
# 1. 依赖目录
# ------------------------------------------------------------
# Node.js 第三方依赖，体积大，可通过 npm install 重新生成
# Dependencies
node_modules/

# ------------------------------------------------------------
# 2. Python 缓存和本地环境
# ------------------------------------------------------------
# Python 编译生成的字节码缓存、测试/检查工具缓存、虚拟环境，
# 均可自动重建，无需提交
# Python caches and local environments
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ------------------------------------------------------------
# 3. 本地密钥和机器特定配置
# ------------------------------------------------------------
# .env 通常存放密钥、数据库密码等敏感信息，全部忽略；
# !.env.example 用 ! 反向保留模板示例（不含真实密钥，需提交供他人参考）
# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
*.local

# ------------------------------------------------------------
# 4. 临时文件和日志
# ------------------------------------------------------------
# ~$* 为 Office 编辑时产生的隐藏临时文件；.DS_Store / Thumbs.db
# 分别是 macOS 和 Windows 的系统缓存文件
# Temporary files and logs
.tmp-skill-validator/
*.tmp
*.temp
*.log
~$*
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# 5. 运行时工作区和生成产物
# ------------------------------------------------------------
# 脚本运行时生成的工作目录和成果输出，频繁变动，不提交
# Runtime workspaces and generated deliverables
survey-report-workspace/
operation-analysis-workspace/
work/
outputs/
runs/
runtime/
qa/

# ------------------------------------------------------------
# 6. 根目录源材料
# ------------------------------------------------------------
# 开头 / 表示只忽略根目录下的文件；这些是原始调研材料
# （Excel、PPT），体积大且可能是数据源，不提交；
# 可复用的模板应放在 agent assets 目录下，不受此限制
# Root-level project source materials; keep reusable templates under agent assets
/*.xlsx
/*.xls
/*.pptx
/*.ppt
/*.docx
/*.pdf
/*.png
/*.jpg
/*.jpeg
/*.zip

# ------------------------------------------------------------
# 7. Office 锁文件
# ------------------------------------------------------------
# Office 打开文档时的锁/恢复文件；最后一行是飞书连接的
# 本地配置文件（含本机连接信息），不提交
# Office lock and recovery files
~$*.docx
~$*.xlsx
~$*.pptx
knowledge_center/feishu-connection.local.json
